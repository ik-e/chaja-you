  "ports": [
    {
      "id": "PORT5-01",
      "provider": "registry",
      "method": "resolve",
      "input": "ResolveUrlRequest",
      "output": "ResolveUrlResponse",
      "notes": "C4-04; no network"
    },
    {
      "id": "PORT5-02",
      "provider": "prep",
      "method": "propose/confirm",
      "input": "ModelProposalRequest / SourceConfirmRequest",
      "output": "ModelProposal / SourceResponse",
      "notes": "C4-03; external AI only on sanitized data; explicit user confirmation"
    },
    {
      "id": "PORT5-03",
      "provider": "remote_session",
      "method": "verify/status/rebind",
      "input": "VerifySessionRequest / ReadRequest / RebindRequest",
      "output": "SessionView / SessionView / RebindResponse",
      "notes": "C4-06 plus coordinator atomic binding; provider runtime choice delegated"
    },
    {
      "id": "PORT5-04",
      "provider": "adapter",
      "method": "build_plan",
      "input": "PlanRequest",
      "output": "Plan",
      "notes": "C4-08; pure proposal, server canonicalizes IDs/digest/permission and stores; no raw browser."
    },
    {
      "id": "PORT5-05",
      "provider": "adapter",
      "method": "preflight",
      "input": "PreflightRequest",
      "output": "PreflightResult",
      "notes": "only restricted read-only port; no page that autosaves"
    },
    {
      "id": "PORT5-06",
      "provider": "gateway",
      "method": "admit_dispatch",
      "input": "Dispatch5Request",
      "output": "DispatchResponse",
      "notes": "C4-07; sole admission, durable attempt and single-use permit"
    },
    {
      "id": "PORT5-07",
      "provider": "adapter",
      "method": "execute_step",
      "input": "StepInput",
      "output": "StepOutcome",
      "notes": "inside gateway only. Restricted port commands scoped to step; no raw persistent driver or network token. Unknown/denied/unexpected stops."
    },
    {
      "id": "PORT5-08",
      "provider": "gateway",
      "method": "observe",
      "input": "ObserveRequest",
      "output": "ObserveResult",
      "notes": "read permission, same identity/target, exclusive read lease. No mutation."
    },
    {
      "id": "PORT5-09",
      "provider": "gateway",
      "method": "stop",
      "input": "StopRequest",
      "output": "StopAck",
      "notes": "same serialization/fencing; no rollback promise."
    }
  ],
  "store": [
    {
      "name": "identity_observations",
      "change": "add",
      "keys": "PK ref; FK connection_ref→connections; owner scope; no job/target/account FK required",
      "fields": "IdentityObservation",
      "invariant": "trusted observation before Account creation; accounts.verification_evidence_ref→identity_observations.ref; verified_at from observation"
    },
    {
      "name": "plans",
      "change": "add logical record",
      "keys": "PK(ref,version); owner derived from target; immutable",
      "fields": "Plan + canonical review mappings/media references",
      "invariant": "approval plan ref/digest and permission ref; operations ref plan version; stable effect_key independent of plan/job"
    },
    {
      "name": "approvals",
      "change": "amend",
      "keys": "FK plan(ref,version); target/account via plan",
      "fields": "Approval5; approval scope immutability + revoked_at epoch",
      "invariant": "no approval without persisted review; revocation may change only revision/status"
    },
    {
      "name": "jobs",
      "change": "amend",
      "keys": "owner via intent/target; index(owner,updated_at,ref) logical; current connection nullable; CAS revision",
      "fields": "Job + plan_ref via approval; updated_at; binding_epoch; stop reason",
      "invariant": "rebind does not mutate plan/approval/intent, only connection ref/epoch; unknown holds"
    },
    {
      "name": "connections",
      "change": "amend",
      "keys": "owner/route/identity binding",
      "fields": "SessionView + candidate_ref + lease generation; runtime opaque",
      "invariant": "system_read vs worker phases; stale generation cannot use viewer/worker"
    },
    {
      "name": "sources",
      "change": "amend",
      "keys": "PK(ref,version), owner/latest index",
      "fields": "SourceResponse + explicit media version refs + confirmation records",
      "invariant": "one snapshot reused across independent platform drafts/jobs; no mutable data copied over approval"
    },
    {
      "name": "evidence",
      "change": "retain",
      "keys": "job/target; attempt optional; identity evidence separate",
      "fields": "V3 Evidence + collector_ref",
      "invariant": "after job creation only; identity observation not fabricated job"
    },
    {
      "name": "rules/operations/attempts",
      "change": "clarify",
      "keys": "rule immutable version; stable operation effect key + attempt history; composite FK operation+plan version",
      "fields": "V3/V4 plus StepSpec and permit admission",
      "invariant": "unknown across new plans/jobs blocked; atomic checks against current permission/lease; effect ledger survives restart"
    },
    {
      "name": "assets/drafts/accounts/targets/intents/permissions/results/object_observations/idempotency/users",
      "change": "retain logical constraints",
      "keys": "V4",
      "fields": "V4",
      "invariant": "physical grouping permitted if ownership, versioning, uniqueness, durability and traceability proved"
    }
  ],
  "rules": [
    {
      "id": "R5-01",
      "title": "계획 승인",
      "rule": "source→confirm→draft→human auth→trusted identity→target→server PlanReview→explicit approval→job→worker lease. Plan digest binds source/draft/rule/media + account/slot/environment + ordered steps/permission/adapter. User receives plan, echoes digest; stale/changed scope requires new plan/approval. Do not require client to derive operation IDs.",
      "refs": [
        "V3-R01",
        "V3-R03",
        "V3-R10"
      ]
    },
    {
      "id": "R5-02",
      "title": "증거 계층",
      "rule": "identity observation (connection prejob) and target eligibility read (connection/target candidate, minimal trusted observation) are stored before job; latter can be embedded redacted preflight/plan evidence reference with owner/connection scope. Job evidence later only. Account evidence ref links identity record; no circular FK.",
