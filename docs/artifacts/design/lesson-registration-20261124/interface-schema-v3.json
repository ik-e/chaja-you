{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chaja-you:lesson-registration:contracts:v3",
  "title": "Lesson registration minimum common types (mock candidate)",
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "Text": {
      "type": "string",
      "minLength": 1
    },
    "Revision": {
      "type": "integer",
      "minimum": 0
    },
    "Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Environment": {
      "const": "mock"
    },
    "JobState": {
      "enum": [
        "active",
        "stopping",
        "done",
        "stopped"
      ]
    },
    "GoalVerdict": {
      "enum": [
        "confirmed",
        "not_reached",
        "unknown"
      ]
    },
    "ProfileRef": {
      "type": "object",
      "properties": {
        "platform": {
          "enum": [
            "kmong",
            "soomgo"
          ]
        },
        "object_kind": {
          "enum": [
            "service_listing",
            "service_configuration"
          ]
        },
        "version": {
          "$ref": "#/$defs/Id"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "environment": {
          "$ref": "#/$defs/Environment"
        }
      },
      "required": [
        "platform",
        "object_kind",
        "version",
        "digest",
        "environment"
      ],
      "additionalProperties": false
    },
    "Value": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Value"
          },
          "minItems": 0
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          }
        }
      ]
    },
    "Values": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Value"
      }
    },
    "Package": {
      "type": "object",
      "properties": {
        "minutes_per_session": {
          "type": "integer",
          "minimum": 1
        },
        "sessions_per_period": {
          "type": "integer",
          "minimum": 1
        },
        "period": {
          "enum": [
            "month",
            "one_off",
            "other"
          ]
        },
        "total_price_krw": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "minutes_per_session",
        "sessions_per_period",
        "period",
        "total_price_krw"
      ],
      "additionalProperties": false
    },
    "AssetInput": {
      "type": "object",
      "properties": {
        "part_name": {
          "$ref": "#/$defs/Id"
        },
        "rights_confirmed": {
          "type": "boolean"
        }
      },
      "required": [
        "part_name",
        "rights_confirmed"
      ],
      "additionalProperties": false
    },
    "AssetRef": {
      "type": "object",
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/Id"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "mime": {
          "enum": [
            "image/png",
            "image/jpeg"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "rights_confirmed": {
          "type": "boolean"
        }
      },
      "required": [
        "asset_id",
        "digest",
        "mime",
        "bytes",
        "width",
        "height",
        "rights_confirmed"
      ],
      "additionalProperties": false
    },
    "SourceInput": {
      "type": "object",
      "properties": {
        "raw_text": {
          "type": "string",
          "minLength": 0
        },
        "previous_source_id": {
          "$ref": "#/$defs/Id"
        },
        "reuse_asset_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "new_assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssetInput"
          },
          "minItems": 0
        }
      },
      "required": [
        "raw_text"
      ],
      "additionalProperties": false
    },
    "SourceView": {
      "type": "object",
      "properties": {
        "source_id": {
          "$ref": "#/$defs/Id"
        },
        "previous_source_id": {
          "$ref": "#/$defs/Id"
        },
        "raw_text": {
          "type": "string",
          "minLength": 0
        },
        "asset_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssetRef"
          },
          "minItems": 0
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "source_id",
        "raw_text",
        "asset_refs",
        "created_at"
      ],
      "additionalProperties": false
    },
    "SourceSummary": {
      "type": "object",
      "properties": {
        "source_id": {
          "$ref": "#/$defs/Id"
        },
        "excerpt": {
          "type": "string",
          "minLength": 0
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "source_id",
        "excerpt",
        "created_at"
      ],
      "additionalProperties": false
    },
    "SourceList": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceSummary"
          },
          "minItems": 0
        },
        "next_cursor": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "ListQuery": {
      "type": "object",
      "properties": {
        "cursor": {
          "$ref": "#/$defs/Id"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "RegistrationInput": {
      "type": "object",
      "properties": {
        "source_id": {
          "$ref": "#/$defs/Id"
        },
        "selector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "source_id",
        "selector"
      ],
      "additionalProperties": false
    },
    "Issue": {
      "type": "object",
      "properties": {
        "issue_id": {
          "$ref": "#/$defs/Id"
        },
        "field": {
          "$ref": "#/$defs/Id"
        },
        "code": {
          "enum": [
            "missing",
            "conflict",
            "invalid",
            "rule_unverified",
            "rights_unknown",
            "unsupported",
            "permission_denied",
            "model_unavailable"
          ]
        },
        "message": {
          "$ref": "#/$defs/Text"
        },
        "blocking": {
          "type": "boolean"
        }
      },
      "required": [
        "issue_id",
        "field",
        "code",
        "message",
        "blocking"
      ],
      "additionalProperties": false
    },
    "Answer": {
      "type": "object",
      "properties": {
        "issue_id": {
          "$ref": "#/$defs/Id"
        },
        "value": {
          "$ref": "#/$defs/Value"
        }
      },
      "required": [
        "issue_id",
        "value"
      ],
      "additionalProperties": false
    },
    "PreparationEdit": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "$ref": "#/$defs/Revision"
        },
        "source_id": {
          "$ref": "#/$defs/Id"
        },
        "selector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "answers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Answer"
          },
          "minItems": 1
        }
      },
      "required": [
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "field": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "enum": [
            "source",
            "user_answer",
            "derived",
            "proposal"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 1
        },
        "note": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "field",
        "kind",
        "refs"
      ],
      "additionalProperties": false
    },
    "Preparation": {
      "type": "object",
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "values": {
          "$ref": "#/$defs/Values"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "minItems": 0
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "minItems": 0
        }
      },
      "required": [
        "ready",
        "values",
        "issues",
        "provenance"
      ],
      "additionalProperties": false
    },
    "AuthCommand": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "open"
            },
            "expected_revision": {
              "$ref": "#/$defs/Revision"
            }
          },
          "required": [
            "action",
            "expected_revision"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "finish"
            },
            "expected_revision": {
              "$ref": "#/$defs/Revision"
            },
            "generation": {
              "$ref": "#/$defs/Revision"
            }
          },
          "required": [
            "action",
            "expected_revision",
            "generation"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "close"
            },
            "expected_revision": {
              "$ref": "#/$defs/Revision"
            },
            "generation": {
              "$ref": "#/$defs/Revision"
            }
          },
          "required": [
            "action",
            "expected_revision",
            "generation"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "refresh"
            },
            "expected_revision": {
              "$ref": "#/$defs/Revision"
            },
            "generation": {
              "$ref": "#/$defs/Revision"
            }
          },
          "required": [
            "action",
            "expected_revision",
            "generation"
          ],
          "additionalProperties": false
        }
      ]
    },
    "AuthView": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "none",
            "human",
            "verifying",
            "verified",
            "closed"
          ]
        },
        "generation": {
          "$ref": "#/$defs/Revision"
        },
        "account_label": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false
    },
    "AuthGrant": {
      "type": "object",
      "properties": {
        "generation": {
          "$ref": "#/$defs/Revision"
        },
        "viewer_grant": {
          "$ref": "#/$defs/Id"
        },
        "expires_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "generation",
        "viewer_grant",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "TargetView": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "new",
            "existing",
            "ambiguous"
          ]
        },
        "account_label": {
          "$ref": "#/$defs/Text"
        },
        "object_kind": {
          "enum": [
            "service_listing",
            "service_configuration"
          ]
        },
        "target_label": {
          "$ref": "#/$defs/Text"
        },
        "existing_registration_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "status",
        "account_label",
        "object_kind",
        "target_label"
      ],
      "additionalProperties": false
    },
    "ReviewView": {
      "type": "object",
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "values": {
          "$ref": "#/$defs/Values"
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssetRef"
          },
          "minItems": 0
        },
        "profile_ref": {
          "$ref": "#/$defs/ProfileRef"
        },
        "target": {
          "$ref": "#/$defs/TargetView"
        },
        "procedure": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "minItems": 1
        },
        "goal": {
          "$ref": "#/$defs/Text"
        },
        "notice": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "digest",
        "values",
        "assets",
        "profile_ref",
        "target",
        "procedure",
        "goal",
        "notice"
      ],
      "additionalProperties": false
    },
    "StartInput": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "$ref": "#/$defs/Revision"
        },
        "review_digest": {
          "$ref": "#/$defs/Digest"
        },
        "approved": {
          "const": true
        },
        "request_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "expected_revision",
        "review_digest",
        "approved",
        "request_key"
      ],
      "additionalProperties": false
    },
    "StepView": {
      "type": "object",
      "properties": {
        "step_id": {
          "$ref": "#/$defs/Id"
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "status": {
          "enum": [
            "pending",
            "confirmed",
            "absent",
            "unknown",
            "error"
          ]
        }
      },
      "required": [
        "step_id",
        "label",
        "status"
      ],
      "additionalProperties": false
    },
    "Progress": {
      "type": "object",
      "properties": {
        "step_index": {
          "type": "integer",
          "minimum": 0
        },
        "step_count": {
          "type": "integer",
          "minimum": 1
        },
        "confirmed_steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepView"
          },
          "minItems": 0
        },
        "current_step": {
          "$ref": "#/$defs/StepView"
        }
      },
      "required": [
        "step_index",
        "step_count",
        "confirmed_steps"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "INVALID_REQUEST",
            "UNAUTHENTICATED",
            "NOT_FOUND",
            "UNSUPPORTED_TARGET",
            "VALIDATION_FAILED",
            "MODEL_UNAVAILABLE",
            "AUTH_REQUIRED",
            "ACCOUNT_MISMATCH",
            "TARGET_AMBIGUOUS",
            "DUPLICATE_RISK",
            "PERMISSION_DENIED",
            "STALE_REVISION",
            "APPROVAL_INVALID",
            "IDEMPOTENCY_CONFLICT",
            "INVALID_PHASE",
            "RUNTIME_ERROR",
            "EFFECT_UNKNOWN",
            "EVIDENCE_INSUFFICIENT"
          ]
        },
        "message": {
          "$ref": "#/$defs/Text"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "minItems": 0
        },
        "current_revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "EffectSummary": {
      "type": "object",
      "properties": {
        "step_id": {
          "$ref": "#/$defs/Id"
        },
        "operation_id": {
          "$ref": "#/$defs/Id"
        },
        "verdict": {
          "enum": [
            "confirmed",
            "absent",
            "unknown"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 0
        }
      },
      "required": [
        "step_id",
        "operation_id",
        "verdict",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "EvidenceView": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "enum": [
            "operation",
            "goal",
            "error"
          ]
        },
        "summary": {
          "$ref": "#/$defs/Text"
        },
        "observed_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "environment": {
          "$ref": "#/$defs/Environment"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "summary",
        "observed_at",
        "environment"
      ],
      "additionalProperties": false
    },
    "Result": {
      "type": "object",
      "properties": {
        "goal_verdict": {
          "$ref": "#/$defs/GoalVerdict"
        },
        "environment": {
          "$ref": "#/$defs/Environment"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EffectSummary"
          },
          "minItems": 0
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceView"
          },
          "minItems": 0
        },
        "error": {
          "$ref": "#/$defs/Error"
        },
        "next_action": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "goal_verdict",
        "environment",
        "effects",
        "evidence"
      ],
      "additionalProperties": false
    },
    "RegistrationView": {
      "type": "object",
      "properties": {
        "registration_id": {
          "$ref": "#/$defs/Id"
        },
        "source_id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "support": {
          "enum": [
            "supported",
            "unsupported",
            "blocked"
          ]
        },
        "profile_ref": {
          "$ref": "#/$defs/ProfileRef"
        },
        "preparation": {
          "$ref": "#/$defs/Preparation"
        },
        "auth": {
          "$ref": "#/$defs/AuthView"
        },
        "target": {
          "$ref": "#/$defs/TargetView"
        },
        "review": {
          "$ref": "#/$defs/ReviewView"
        },
        "job_state": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/JobState"
            }
          ]
        },
        "progress": {
          "$ref": "#/$defs/Progress"
        },
        "result": {
          "$ref": "#/$defs/Result"
        }
      },
      "required": [
        "registration_id",
        "source_id",
        "revision",
        "support",
        "preparation",
        "auth",
        "job_state"
      ],
      "additionalProperties": false
    },
    "AuthResponse": {
      "type": "object",
      "properties": {
        "registration": {
          "$ref": "#/$defs/RegistrationView"
        },
        "grant": {
          "$ref": "#/$defs/AuthGrant"
        }
      },
      "required": [
        "registration"
      ],
      "additionalProperties": false
    },
    "RegistrationSummary": {
      "type": "object",
      "properties": {
        "registration_id": {
          "$ref": "#/$defs/Id"
        },
        "source_id": {
          "$ref": "#/$defs/Id"
        },
        "profile_ref": {
          "$ref": "#/$defs/ProfileRef"
        },
        "job_state": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/JobState"
            }
          ]
        },
        "goal_verdict": {
          "$ref": "#/$defs/GoalVerdict"
        }
      },
      "required": [
        "registration_id",
        "source_id",
        "job_state"
      ],
      "additionalProperties": false
    },
    "RegistrationList": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RegistrationSummary"
          },
          "minItems": 0
        },
        "next_cursor": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "KmongValues": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 10,
          "maxLength": 30
        },
        "category": {
          "const": "music"
        },
        "description": {
          "type": "string",
          "minLength": 100
        },
        "delivery": {
          "enum": [
            "in_person",
            "online",
            "hybrid"
          ]
        },
        "region": {
          "$ref": "#/$defs/Text"
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Package"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "vat_included": {
          "type": "boolean"
        },
        "process": {
          "type": "string",
          "minLength": 50
        },
        "preparation": {
          "type": "string",
          "minLength": 50
        },
        "main_image": {
          "$ref": "#/$defs/AssetRef"
        }
      },
      "required": [
        "title",
        "category",
        "description",
        "delivery",
        "packages",
        "vat_included",
        "process",
        "preparation",
        "main_image"
      ],
      "additionalProperties": false
    },
    "SoomgoValues": {
      "type": "object",
      "properties": {
        "category": {
          "const": "midi"
        },
