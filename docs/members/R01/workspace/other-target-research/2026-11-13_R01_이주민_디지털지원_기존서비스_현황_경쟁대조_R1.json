  "method": "1차 출처(정부·공공기관·제공기관) 기능 확인, 2025 사용자 실태조사, 반증 중심 공백 분석; 가입/개인정보 제공/실제 이용자 동작·서비스 내 메시지 전송은 미실시",
  "goal_contract": {
    "goal": "첫 사용자 집단 선정 전에 기존 서비스·이용 현황·반대 근거를 충분히 정리하고 도메인 결정 보류/추가 검증 기준을 제안",
    "done_when": [
      "정부/공공/비영리/민간/상담인력 주요 서비스 10개 이상 비교",
      "2025년 이후 실제 사용자 불편 근거 확보",
      "이미 해결된 기능과 미확인 간극 구분",
      "최소 3개 사용자/지원자 문제 후보의 반증 기준 도출",
      "GitHub 개인 브랜치에 근거 JSON/보고서 저장 및 재확인"
    ],
    "reopen_research_when": [
      "기준 서비스 신규 출시에 따라 기능 비교가 바뀜",
      "현장 사용 평가에서 새로운 이탈 원인이 발견됨",
      "제공사 발표만으로는 실제 실행을 판정할 수 없는 핵심 기능 발생"
    ],
    "stop_when": [
      "위 비교·반증 기준을 충족하고 남은 핵심 불확실성이 현장·제품 사용실험에 달림",
      "이용 약관/접근권한 제약으로 직접 이용 불가",
      "개인/조직 공식 방향 변경에 사람 승인 필요"
    ],
    "no_automatic_decisions": [
      "찾아you 공식 도메인·타겟 변경",
      "APP-A/C 필수 범위 변경",
      "지원자의 실제 개인정보 수집",
      "비자·법률 등 고위험 결정을 AI가 대신 내림"
    ]
  },
