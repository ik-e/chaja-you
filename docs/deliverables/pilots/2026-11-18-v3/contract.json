        ],
        [
          "status",
          "TEXT",
          "NOT NULL CHECK status IN task_status",
          "task lifecycle"
        ],
        [
          "created_at",
          "TIMESTAMPTZ",
          "NOT NULL DEFAULT now()",
          "creation timestamp"
        ]
      ],
      "uniques": [
        [
          "request_id",
          "task_id"
        ]
      ],
      "fks": [
        [
          "request_id",
          "research_request.request_id"
        ]
      ]
    },
    {
      "name": "task_attempt",
      "pk": [
        "attempt_id"
      ],
      "columns": [
