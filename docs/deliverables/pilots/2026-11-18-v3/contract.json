  ],
  "invariants": [
    {
      "id": "I-OWNER",
      "rule": "request.owner_id equals validated JWT.sub for API-02/03/04; nested records cannot be read without same parent scope",
      "enforcement": "authorization middleware + parent-scoped queries; optional RLS if PostgreSQL adopted"
    },
    {
      "id": "I-TASK",
      "rule": "verdict.request_id equals research_task.request_id for verdict.task_id",
      "enforcement": "composite FK (request_id,task_id) referencing unique research_task(request_id,task_id), or equivalent transactional validation"
    },
    {
      "id": "I-EVIDENCE",
      "rule": "for verdict_evidence row the evidence.source.task.request_id equals verdict.request_id",
      "enforcement": "transaction/trigger or equivalent validated write path; plain two FKs insufficient"
    },
    {
      "id": "I-VERDICT",
      "rule": "fulfilled or not_fulfilled verdict requires verified evidence, else unknown; source access failure never proves not_fulfilled",
      "enforcement": "server validation and test fixtures; SQL FK alone insufficient"
    },
    {
      "id": "I-IDEMPOTENCY",
      "rule": "POST retry with same owner,key,payload returns existing request; same key with different payload yields 409",
      "enforcement": "atomic unique key + stored payload fingerprint, to be defined before implementation"
    }
  ],
  "rls_roles": [
    {
      "role": "anonymous",
      "select": "deny",
      "insert": "deny",
      "update": "deny",
      "delete": "deny"
    },
    {
      "role": "authenticated_owner",
      "select": "own request and child rows",
      "insert": "POST via authorized API",
      "update": "server-controlled only",
      "delete": "server-controlled policy TBD"
    },
    {
      "role": "service_worker",
      "select": "scoped assigned request",
      "insert": "allowed retrieval/evidence transaction",
      "update": "task status with server guard",
      "delete": "no default"
    }
  ],
  "optional_technologies": [
    {
      "tech": "pgvector",
      "decision": "conditional_not_selected",
      "reason": "the APP-A fixed-candidate source-linking flow does not yet require embedding search",
      "if_used": "document/quote chunk tables, embedding model, dimension/vector operator and index/search evaluation required",
      "review": "confirm educational applicability with instructor/manager after selected domain"
    },
    {
      "tech": "Redis",
      "decision": "conditional_not_selected",
      "reason": "current prototype does not establish a distributed session/cache need",
      "if_used": "session:{id} key, TTL, revocation, cache invalidation and auth separation",
      "review": "confirm on selected backend/auth approach"
    },
    {
      "tech": "JWT/RLS",
      "decision": "provisional_multiuser_proposal",
      "reason": "API promises resource ownership, so a design must show subject and row relationship",
      "if_used": "verified JWT sub, request owner_id; optionally RLS for PostgreSQL",
      "review": "if single-user/anonymous prototype chosen replace both with a concrete alternative access boundary"
    }
  ],
  "indexes": [
    {
      "table": "research_task",
      "cols": [
        "request_id"
      ],
      "query": "API-04 tasks by request"
    },
    {
      "table": "source",
      "cols": [
        "task_id"
      ],
      "query": "source by task"
    },
    {
      "table": "verdict",
      "cols": [
        "request_id",
        "candidate_id",
        "condition_id"
      ],
      "query": "API-03 filter result"
    },
    {
      "table": "evidence",
      "cols": [
        "source_id"
      ],
      "query": "evidence by source"
    }
  ],
  "tests": [
    {
      "id": "T-INPUT",
      "expect": "invalid empty targets → 422",
      "kind": "planned_not_run"
    },
    {
      "id": "T-OWNER",
      "expect": "different JWT sub cannot read request or nested result → 404",
      "kind": "planned_not_run"
    },
    {
      "id": "T-TRACE",
      "expect": "foreign task/evidence request scope is rejected, never linked to another user's verdict",
      "kind": "planned_not_run"
    },
    {
      "id": "T-UNKNOWN",
      "expect": "failed source cannot be marked fulfilled/not_fulfilled without verified evidence",
      "kind": "planned_not_run"
    },
    {
      "id": "T-IDEMPOTENCY",
      "expect": "same key same input → same ID; changed input → 409",
      "kind": "planned_not_run"
    }
  ]
}
