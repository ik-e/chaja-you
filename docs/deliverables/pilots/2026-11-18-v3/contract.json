          "safe failure code"
        ],
        [
          "started_at",
          "TIMESTAMPTZ",
          "NULL",
          "actual start"
        ],
        [
          "finished_at",
          "TIMESTAMPTZ",
          "NULL",
          "actual finish"
        ],
        [
          "created_at",
          "TIMESTAMPTZ",
          "NOT NULL DEFAULT now()",
          "creation timestamp"
        ]
      ],
      "uniques": [
        [
          "task_id",
          "attempt_no"
        ]
      ],
      "fks": [
        [
          "task_id",
          "research_task.task_id"
        ]
      ]
    },
    {
      "name": "source",
      "pk": [
        "source_id"
      ],
      "columns": [
