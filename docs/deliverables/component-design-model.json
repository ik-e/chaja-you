    "logical_data_entities": [
      {
        "id": "DT-CASE",
        "name": "Case",
        "fields": [
          "case_id: unique identifier",
          "case_status: draft|unverified|review_pending|reviewed",
          "created_at: timestamp"
        ],
        "constraints": [
          "상태 변경은 허가된 전이를 통해서만"
        ],
        "owner_container": "CTN-DATA",
        "logical_owner": "C-APP-CASE"
      },
      {
        "id": "DT-OBS",
        "name": "Observation",
        "fields": [
          "obs_id: unique identifier",
          "case_id: Case reference",
          "kind: observed|inferred|unknown",
          "source: information origin"
        ],
        "constraints": [
          "unknown은 확정 위반을 의미하지 않음"
        ],
        "owner_container": "CTN-DATA",
        "logical_owner": "C-EVIDENCE-POLICY"
      },
      {
        "id": "DT-ACTION",
        "name": "Action",
        "fields": [
          "action_id: unique identifier",
          "case_id: Case reference",
          "actor: role/id in simulation",
          "kind: create|review_request|review",
          "timestamp: recorded time"
        ],
        "constraints": [
          "이력의 임의 자동 삭제·허구 시각 생성 불허"
        ],
        "owner_container": "CTN-DATA",
        "logical_owner": "C-AUDIT"
      }
    ],
    "example_contracts": [
      {
        "id": "IF-CASE-CREATE",
        "entrypoint": "POST /cases",
        "request": "Observation[kind:ObservationKind,source] + optional memo; actor context (case_id is server generated)",
        "response": "case_id (server generated), status:CaseStatus, evidence_kind:ObservationKind",
        "errors": [
          "invalid_input",
          "permission_denied",
          "invalid_transition",
          "storage_failure"
        ],
        "domain_refs": [
          "EX-FR",
          "EX-WF",
          "EX-DATA",
          "EX-API"
        ],
        "status": "illustrative_only"
      },
      {
        "id": "IF-CASE-GET",
        "entrypoint": "GET /cases/{case_id}",
        "request": "case_id,actor context",
        "response": "Case Summary with evidence kinds and review status",
        "errors": [
          "permission_denied",
          "not_found",
          "storage_failure"
        ],
        "domain_refs": [
          "EX-API",
          "EX-UI"
